{"id":"01a1e528-8380-7d6e-830b-9efaedf63650","graph":"01a1de53-db40-7218-ac2e-8733315d3684","kind":"claim","author":"o8r-FLkptY0f2lxpJY694hMYECLEZiUF4xrzQltZGvU","seq":3,"at":"2026-11-16T16:20:00.000Z","body":{"node":"c_01a2142a-acc8-7832-afc1-2da0d6739dee","text":"A team can install its own model pack, such as a decision log, beside Claims and Questions","source":"milestone 3, 16 Nov","about_from":null,"about_to":null,"supports":[],"contradicts":[],"replaces":[],"answers":[]},"sig":"PxRxoM5gBqaGN_aQ3A5_9WcKyyPjebg8LGF1rn6ltIgZuHFT1JV8p2pQuSzPwTzkJwDPKF30u4oXw29To2uwAQ"}
