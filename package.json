{
  "name": "vine-context",
  "version": "0.1.1",
  "description": "Share a Relate context graph with other people's AI agents, peer to peer. An AI skill plus a local MCP server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CraigDeverall/vine-context.git"
  },
  "homepage": "https://github.com/CraigDeverall/vine-context#readme",
  "bugs": "https://github.com/CraigDeverall/vine-context/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vine": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "models",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "relate",
    "neo4j",
    "mcp",
    "context-graph",
    "p2p",
    "webrtc",
    "claude-code",
    "agent-skill"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-apps.mjs",
    "typecheck": "tsc --noEmit && tsc -p apps",
    "test": "vitest run",
    "test:turn": "node scripts/turn-server.mjs test",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run build",
    "build:apps": "node scripts/build-apps.mjs",
    "build:embedder": "node scripts/build-embedder.mjs",
    "pack:embedder": "node scripts/pack-embedder.mjs --pack",
    "examples": "tsx scripts/make-examples.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@relate/relate": "1.0.1",
    "node-datachannel": "^0.33.6",
    "nostr-tools": "^2.26.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@squonk/ui": "file:vendor/squonk-ui-9.1.0.tgz",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "vine-context-embedder-darwin-arm64": "0.1.0",
    "vine-context-embedder-darwin-x64": "0.1.0",
    "vine-context-embedder-linux-arm64": "0.1.0",
    "vine-context-embedder-linux-x64": "0.1.0",
    "vine-context-embedder-win32-x64": "0.1.0"
  }
}
